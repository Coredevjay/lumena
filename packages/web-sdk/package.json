{
  "name": "@lumen/web-sdk",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "test:cjs": "node --input-type=commonjs -e \"require('./dist/index.cjs')\"",
    "validate:publint": "publint",
    "validate:attw": "attw --pack .",
    "validate": "pnpm run validate:publint && pnpm run validate:attw"
  },
  "dependencies": {
    "@lumen/core": "workspace:*",
    "@lumen/types": "workspace:*"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "^17.0.1"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@lumen/server": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "buffer": "^6.0.3",
    "publint": "^0.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^5.0.0"
  }
}