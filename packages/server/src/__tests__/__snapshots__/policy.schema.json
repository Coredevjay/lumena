{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "walletId": {
      "type": "string",
      "pattern": "^G[A-Z2-7]{55}$"
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "spend_limit"
              },
              "asset": {
                "type": "string",
                "minLength": 1
              },
              "maxPerTx": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              },
              "maxDaily": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              }
            },
            "required": [
              "type",
              "asset",
              "maxPerTx",
              "maxDaily"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "velocity"
              },
              "maxTransactions": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "windowMinutes": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "maxTransactions",
              "windowMinutes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "allowlist"
              },
              "destinations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^G.*"
                }
              }
            },
            "required": [
              "type",
              "destinations"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "blocklist"
              },
              "destinations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "starts_with",
                  "pattern": "^G.*"
                }
              }
            },
            "required": [
              "type",
              "destinations"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "asset_allowlist"
              },
              "assets": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "type",
              "assets"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "max_operations"
              },
              "maxOperations": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "maxOperations"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "fee_limit"
              },
              "maxFeeStroops": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "type",
              "maxFeeStroops"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "contract_allowlist"
              },
              "allowedContracts": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "contractId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "methods": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "contractId"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "allowedContracts"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "walletId",
    "rules"
  ],
  "additionalProperties": false
}
