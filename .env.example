# =============================================================================
# Lumen server — environment configuration
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# NEVER commit a real .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Stellar network
# -----------------------------------------------------------------------------
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# -----------------------------------------------------------------------------
# Signer provider
# -----------------------------------------------------------------------------
# Controls how the co-signer and fee-payer private keys are accessed.
#
#   env     (default) — raw Stellar secret keys loaded from the variables below.
#                       Safe for local development and testnet only.
#                       ⚠  These keys are CUSTODIAL: they can approve user txs
#                       and spend XLM.  Do NOT use raw secrets in production.
#
#   awskms  (recommended for production) — private keys never leave AWS KMS /
#           CloudHSM.  Set the KMS_* variables below and leave COSIGNER_SECRET
#           and FEE_PAYER_SECRET unset.
#           Requires @aws-sdk/client-kms and appropriate IAM permissions.
#           See docs/production-key-management.md.
#
#   pkcs11  (enterprise custody) — private keys never leave an on-premises or
#           cloud HSM accessed via the PKCS#11 C API.  Set the PKCS11_*
#           variables below and leave COSIGNER_SECRET and FEE_PAYER_SECRET
#           unset.  Requires the pkcs11js native binding and the vendor's
#           PKCS#11 module (e.g. SoftHSM2 for local integration testing).
#
SIGNER_PROVIDER=env

# -----------------------------------------------------------------------------
# Dev / testnet secrets (SIGNER_PROVIDER=env only)
# ⚠  Raw secret keys in environment variables are NOT suitable for production.
#    A stolen COSIGNER_SECRET lets an attacker co-sign arbitrary user txs.
#    A stolen FEE_PAYER_SECRET drains your XLM fee reserve.
#    Use SIGNER_PROVIDER=awskms in production instead.
# -----------------------------------------------------------------------------
COSIGNER_SECRET=S...          # Server co-signer secret key  (testnet only)
FEE_PAYER_SECRET=S...         # Fee sponsor secret key        (testnet only)

# -----------------------------------------------------------------------------
# AWS KMS signers (SIGNER_PROVIDER=awskms only)
# These are IGNORED when SIGNER_PROVIDER=env.
# -----------------------------------------------------------------------------
# KMS_COSIGNER_KEY_ID=arn:aws:kms:<region>:<account>:key/<uuid>
# KMS_FEE_PAYER_KEY_ID=arn:aws:kms:<region>:<account>:key/<uuid>
# KMS_REGION=us-east-1

# -----------------------------------------------------------------------------
# PKCS#11 HSM signer (SIGNER_PROVIDER=pkcs11 only)
# These are IGNORED unless SIGNER_PROVIDER=pkcs11.
# Private key material never leaves the HSM; only signatures are returned.
# -----------------------------------------------------------------------------
# Absolute path to the vendor PKCS#11 module shared library.
#   SoftHSM2 (local): /usr/lib/softhsm/libsofthsm2.so
#   YubiHSM2:         /usr/lib/x86_64-linux-gnu/pkcs11/yubihsm_pkcs11.so
# PKCS11_MODULE_PATH=/usr/lib/softhsm/libsofthsm2.so
# PKCS#11 slot ID containing the co-signer key (numeric).
# PKCS11_SLOT_ID=0
# User PIN used to log in to the token.  Prefer a secret manager over a
# plaintext .env in production.
# PKCS11_PIN=1234
# CKA_LABEL of the private key object used for signing.
# PKCS11_KEY_LABEL=lumen-cosigner

# -----------------------------------------------------------------------------
# Soroban simulation policy (issue #503)
# -----------------------------------------------------------------------------
# Before co-signing a Soroban invocation the server calls simulateTransaction
# and rejects the request with HTTP 422 when the simulation fails or when the
# simulated resource fee exceeds the configured policy.  The simulation summary
# is recorded in the audit log.
# Maximum resource fee (in stroops) the sponsor is willing to pay for a single
# invocation.  Defaults to 1000000 (0.1 XLM).
# SOROBAN_SIM_MAX_RESOURCE_FEE_STROOPS=1000000
# Maximum CPU instructions the invocation may consume.  Defaults to 100000000.
# SOROBAN_SIM_MAX_CPU_INSTRUCTIONS=100000000
# Maximum memory (in bytes) the invocation may consume.  Defaults to 41943040.
# SOROBAN_SIM_MAX_MEMORY_BYTES=41943040
# Maximum ledger entries the footprint may read.  Defaults to 40.
# SOROBAN_SIM_MAX_READ_ENTRIES=40
# Maximum ledger entries the footprint may write.  Defaults to 25.
# SOROBAN_SIM_MAX_WRITE_ENTRIES=25
# Maximum ledger entry size (in bytes) in the footprint.  Defaults to 65536.
# SOROBAN_SIM_MAX_ENTRY_SIZE_BYTES=65536

# -----------------------------------------------------------------------------
# Sponsor account rotation (issue #504)
# -----------------------------------------------------------------------------
# Multiple fee-sponsor accounts may be configured for weighted selection and
# zero-downtime rotation.  When SPONSOR_ACCOUNTS is set it takes precedence over
# FEE_PAYER_SECRET.
#
# Selection strategy: a weighted random choice among all accounts that are not
# draining and not exhausted.  An account is skipped when its weight is 0, when
# it is flagged as draining (drain=true), or when its balance is below
# SPONSOR_MIN_BALANCE_STROOPS.  If no account is eligible the request fails.
#
# Rotation procedure: add the new account with its weight, set drain=true on
# the old account so it stops receiving new requests, wait for in-flight
# transactions to settle, then remove it.
#
# Format: JSON array of objects with the fields:
#   secret  (string, required)  Stellar secret key (S...) of the sponsor.
#   weight  (number, optional)  Relative selection weight.  Defaults to 1.
#   drain   (boolean, optional) When true the account receives no new work.
#   label   (string, optional)  Human-readable identifier used in logs/audit.
# Example:
# SPONSOR_ACCOUNTS=[{"label":"sponsor-a","secret":"S...","weight":3},{"label":"sponsor-b","secret":"S...","weight":1,"drain":true}]
# Minimum sponsor balance (in stroops) for an account to be considered
# eligible.  Defaults to 10000000 (1 XLM).
# SPONSOR_MIN_BALANCE_STROOPS=10000000

# -----------------------------------------------------------------------------
# Audit log export (issue #505)
# -----------------------------------------------------------------------------
# GET /audit/export streams decisions as JSONL or CSV, filtered by wallet and
# date range, with a signed manifest containing the Merkle root so the export
# can be verified offline.  Streaming is constant-memory regardless of size.
# Maximum number of records per export request.  Defaults to 100000.
# AUDIT_EXPORT_MAX_RECORDS=100000
# Page size used when streaming records from storage.  Defaults to 1000.
# AUDIT_EXPORT_PAGE_SIZE=1000
# Secret used to sign export manifests (HMAC).  Use a long random value
# (e.g. `openssl rand -hex 32`).  Required to enable /audit/export.
AUDIT_EXPORT_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Idempotency (issue #506)
# -----------------------------------------------------------------------------
# Controls the idempotency middleware used by mutating endpoints.
#
#   IDEMPOTENCY_STORE  Storage backend for idempotency keys.
#                      "memory" (default) — in-process map; suitable for a
#                        single instance only, cleared on restart.
#                      "redis"            — shared store; requires REDIS_URL and
#                        is required when running more than one instance.
#
#   IDEMPOTENCY_TTL_SECONDS  How long a completed idempotency record is kept,
#                      in seconds.  Defaults to 86400 (24 hours).  After expiry
#                      the key may be reused and the request is processed anew.
#
# Conflict semantics: a request carrying an Idempotency-Key that is still in
# flight returns HTTP 409.  A repeated request with the same key and the same
# request body replays the stored response (including status code).  A repeated
# request with the same key but a different body returns HTTP 422.
IDEMPOTENCY_STORE=memory
# IDEMPOTENCY_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Anchor (Phase 1)
# -----------------------------------------------------------------------------
ANCHOR_URL=https://testanchor.stellar.org
ANCHOR_AUTH_SECRET=S...

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Shared Redis instance used by:
#   - the distributed sequence-number allocator (Redlock) for the fee sponsor
#     and co-signer accounts (issue #233),
#   - the webhook retry pipeline (BullMQ) and dead-letter queue (issue #236).
# Required when running more than one server instance or when webhook retries
# are enabled.  Example: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
# Optional API key for protecting server endpoints (Authorization: Bearer <api-key>)
# Legacy single-tenant key.  Prefer per-tenant API keys (issue #234); when set,
# this key is still accepted for backwards compatibility.
API_KEY=
# Rate limiting for /cosign and /fee-bump
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# -----------------------------------------------------------------------------
# CORS (issue #508)
# -----------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call the API,
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
# Origins are parsed and validated at startup; the server fails fast on an
# invalid entry (must be a bare origin: scheme://host[:port], no path).
# The wildcard "*" is FORBIDDEN whenever API_KEY is set or credentialed
# requests are used (the server sends Access-Control-Allow-Credentials), as
# that combination is unsafe.  Leave unset to disable cross-origin access.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Configuration reload (issue #510)
# -----------------------------------------------------------------------------
# Sending SIGHUP to the server process reloads the following settings without
# a restart.  Invalid values are logged and the previous values are kept.
#
#   Reloadable via SIGHUP:
#     - LUMEN_LOG_LEVEL
#     - RATE_LIMIT_WINDOW_MS
#     - RATE_LIMIT_MAX
#     - CORS_ORIGINS
#
#   Require a restart (NOT reloadable):
#     - STELLAR_NETWORK, HORIZON_URL, SOROBAN_RPC_URL
#     - SIGNER_PROVIDER and all signer/KMS/PKCS#11 settings
#     - ANCHOR_URL, ANCHOR_AUTH_SECRET
#     - REDIS_URL
#     - PORT, API_KEY
#     - LUMEN_JWT_SECRET, SEP10_* settings
#     - LUMEN_WEBHOOK_DLQ_* settings
#     - OTEL_* settings
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# SEP-10 web authentication (issue #235)
# -----------------------------------------------------------------------------
# Secret used to sign JWTs issued by POST /auth/token.  Use a long random
# value (e.g. `openssl rand -hex 32`).  Required to enable /auth endpoints.
LUMEN_JWT_SECRET=
# Stellar secret key (S...) of the server account that signs SEP-10 challenge
# transactions.  Falls back to COSIGNER_SECRET when unset.
SEP10_SERVER_SIGNING_KEY=
# Home domain included in the SEP-10 challenge's manage-data operation.
# Defaults to the host of the incoming request when unset.
SEP10_HOME_DOMAIN=localhost
# Lifetime of a SEP-10 challenge transaction, in seconds.  Defaults to 300.
# SEP10_CHALLENGE_TTL_SECONDS=300
# Lifetime of issued JWTs, in seconds.  Defaults to 86400 (24 hours).
# LUMEN_JWT_TTL_SECONDS=86400

# -----------------------------------------------------------------------------
# Webhook delivery & dead-letter queue (issue #236)
# -----------------------------------------------------------------------------
# Retries use exponential backoff at 1m, 5m, 15m, 1h and 6h.  Deliveries that
# still fail are moved to the dead-letter queue for manual inspection/retry.
# Number of delivery attempts before routing to the DLQ.  Defaults to 5.
# LUMEN_WEBHOOK_DLQ_MAX_ATTEMPTS=5
# How long failed deliveries are retained in the DLQ, in seconds.
# Defaults to 604800 (7 days).
# LUMEN_WEBHOOK_DLQ_TTL_SECONDS=604800
# Redis key prefix for webhook queues and DLQ entries.
# Defaults to "lumen:webhook".
# LUMEN_WEBHOOK_DLQ_PREFIX=lumen:webhook
# Per-request timeout for webhook HTTP deliveries, in milliseconds.
# Defaults to 10000.
# LUMEN_WEBHOOK_DLQ_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Pino log level for the server logger.
# Valid values: trace, debug, info, warn, error, fatal
# Defaults to "info" when unset or invalid.
LUMEN_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# OpenTelemetry distributed tracing
# -----------------------------------------------------------------------------
# Traces HTTP requests, Redis policy checks, and Stellar RPC / Horizon calls,
# and exports them to an OTLP collector (Jaeger, Tempo, etc.).
# Tracing is disabled when OTEL_EXPORTER_OTLP_ENDPOINT is unset.
# -----------------------------------------------------------------------------
# OTLP/HTTP collector endpoint (e.g. http://localhost:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Service name reported in traces.  Defaults to "lumen-server".
# OTEL_SERVICE_NAME=lumen-server
# Trace sampler.  Valid values: always_on, always_off, traceidratio,
# parentbased_always_on, parentbased_always_off, parentbased_traceidratio.
# Defaults to "parentbased_always_on".
# OTEL_TRACES_SAMPLER=parentbased_always_on
# Ratio used by the *traceidratio samplers (0.0 – 1.0).
# OTEL_TRACES_SAMPLER_ARG=1.0
# Optional headers sent to the collector, e.g. for auth:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20<token>
