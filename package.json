{
  "name": "lumen",
  "version": "1.0.0",
  "private": true,
  "sideEffects": false,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "tsup && pnpm -r run build",
    "build:tsup": "tsup",
    "validate:package": "publint && attw --pack .",
    "test": "pnpm -r run test",
    "test:fuzz": "pnpm -r run test:fuzz",
    "lint": "pnpm -r run lint",
    "lint:security": "eslint --no-eslintrc --config scripts/linter/eslint.config.js --ext .js,.jsx,.ts,.tsx .",
    "typecheck": "pnpm -r run typecheck",
    "contracts:build": "cargo build --manifest-path contracts/Cargo.toml --target wasm32-unknown-unknown --release",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "benchmarks:run": "cargo run --package benchmarks --bin benchmarks",
    "benchmarks:view": "node contracts/benchmarks/viewer/server.js",
    "benchmarks": "pnpm run benchmarks:run && pnpm run benchmarks:view",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "commitlint": "commitlint",
    "commitlint:pr": "commitlint --from origin/main --to HEAD",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.7",
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "astro": "^4.15.0",
    "@astrojs/starlight": "^0.27.0",
    "@arethetypeswrong/cli": "^0.16.4",
    "fast-check": "^3.19.0",
    "publint": "^0.2.11",
    "tsup": "^8.3.0"
  },
  "packageManager": "pnpm@9.15.4"
}
