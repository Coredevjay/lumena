// Prisma schema for Lumen relational persistence layer.
// Target: packages/server/src/db/schema.prisma
//
// Provides ACID-compliant storage for wallets, policies, policy rules,
// transaction audit trails, and webhook subscriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A wallet registered with the Lumen policy engine.
model Wallet {
  id        String   @id @default(uuid())
  address   String   @unique
  label     String?
  tags      String[] @default([])
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies          Policy[]
  transactionAudits TransactionAudit[]
  webhookSubscriptions WebhookSubscription[]

  @@index([address])
  @@index([createdAt])
  @@index([tags], type: Gin)
  @@map("wallets")
}

/// A policy attached to a wallet. Each wallet has at most one active policy
/// per `walletId` (enforced by the unique constraint).
model Policy {
  id          String   @id @default(uuid())
  walletId    String   @unique
  name        String
  description String?
  enabled     Boolean  @default(true)
  version     Int      @default(1)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  wallet   Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  rules    PolicyRule[]
  versions PolicyVersion[]

  @@index([walletId])
  @@index([enabled])
  @@map("policies")
}

/// An immutable snapshot of a policy at a given version, used for auditing
/// and rollback of policy changes.
model PolicyVersion {
  id        String   @id @default(uuid())
  policyId  String
  version   Int
  author    String
  rules     Json
  createdAt DateTime @default(now())

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@index([policyId])
  @@map("policy_versions")
}

/// An individual rule belonging to a policy.
model PolicyRule {
  id        String   @id @default(uuid())
  policyId  String
  ruleType  String
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([policyId, priority])
  @@map("policy_rules")
}

/// Immutable audit record for a transaction evaluated by the policy engine.
model TransactionAudit {
  id            String   @id @default(uuid())
  walletId      String
  transactionId String?
  decision      String
  reason        String?
  amount        String?
  asset         String?
  payload       Json?
  createdAt     DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([walletId, createdAt])
  @@index([transactionId])
  @@index([decision])
  // Supports streaming audit exports filtered by wallet and date range
  // (GET /audit/export). The composite index allows an index-only range scan
  // ordered by createdAt so exports can be paginated with constant memory.
  @@index([createdAt])
  @@index([walletId, createdAt, id])
  @@map("transaction_audits")
}

/// A signed manifest describing an audit log export.
///
/// The manifest captures the filter parameters used for the export, the
/// Merkle root over the exported records, and a signature so compliance
/// teams can verify the export offline without access to the server.
model AuditExport {
  id           String   @id @default(uuid())
  walletId     String?
  fromDate     DateTime?
  toDate       DateTime?
  format       String   @default("jsonl")
  recordCount  Int      @default(0)
  merkleRoot   String
  signature    String
  signerKeyId  String?
  createdAt    DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@index([walletId, createdAt])
  @@map("audit_exports")
}

/// A webhook subscription for receiving policy/audit events.
model WebhookSubscription {
  id        String   @id @default(uuid())
  walletId  String?
  url       String
  secret    String?
  events    String[]
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet     Wallet?           @relation(fields: [walletId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]

  @@index([walletId])
  @@index([enabled])
  @@map("webhook_subscriptions")
}

/// A multi-tenant API consumer with scoped permissions and tiered quotas.
model Tenant {
  id                 String   @id @default(uuid())
  name               String
  apiKeyHash         String   @unique
  tier               String   @default("free")
  monthlyGasQuotaXlm Decimal  @default(0) @db.Decimal(20, 7)
  monthlyGasUsedXlm  Decimal  @default(0) @db.Decimal(20, 7)
  allowedDomains     String[] @default([])
  quotaResetAt       DateTime
  /// Stellar network this tenant is scoped to (e.g. "testnet", "mainnet").
  /// Null falls back to the server-wide STELLAR_NETWORK default.
  network            String?
  /// Optional per-tenant network overrides (horizon/rpc/passphrase/sponsor).
  networkConfig      Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([apiKeyHash])
  @@index([tier])
  @@index([quotaResetAt])
  @@index([network])
  @@map("tenants")
}

/// A single webhook delivery attempt, tracked for retries and dead-lettering.
model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  event        String
  payload      Json
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastError    String?
  nextRetryAt  DateTime?
  deadLettered Boolean   @default(false)
  replayedAt   DateTime?
  replayCount  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  webhook WebhookSubscription @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([webhookId, createdAt])
  @@index([status])
  @@index([deadLettered])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}